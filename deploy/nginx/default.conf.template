# La imagen oficial de nginx reemplaza ${DOMINIO} al arrancar (envsubst sobre /etc/nginx/templates).
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMINIO};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Imágenes en base64 que manda el chat (el backend acepta hasta 10 MB)
    client_max_body_size 12m;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # API: /api/xxx → backend:3000/xxx
    location /api/ {
        proxy_pass http://backend:3000/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Las respuestas del tutor (varios agentes + OpenAI) pueden tardar
        proxy_read_timeout 120s;
    }

    # Frontend Angular (SPA)
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|woff2?|ttf|png|jpg|jpeg|svg|ico)$ {
        expires 7d;
        access_log off;
    }
}
