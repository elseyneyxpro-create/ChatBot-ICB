# Copiar a deploy/.env y completar. NO subir el .env a GitHub.

# Dominio de la VM (Google OAuth no acepta IPs, solo dominios con HTTPS)
DOMINIO=chatbot.ejemplo.udp.cl

# PostgreSQL (reemplaza a Supabase)
POSTGRES_USER=icb_user
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=icb_chatbot

# MongoDB (reemplaza a Firestore)
MONGO_USER=icb_user
MONGO_PASSWORD=cambiar_esta_clave
MONGO_DB=icb_chatbot

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Secreto compartido backend ↔ servicio Python (cualquier string largo y aleatorio)
INTERNAL_SECRET=cambiar_por_un_string_largo

# Sesión (cookie JWT)
JWT_SECRET=cambiar_por_otro_string_largo
JWT_EXPIRES=7d

# Google OAuth (Google Cloud Console → Credenciales → ID de cliente OAuth)
# URI de redireccionamiento autorizado: https://DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAIN=mail.udp.cl

PYTHON_TIMEOUT_MS=90000

